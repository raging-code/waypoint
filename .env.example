# Copy this file to ".env" and edit. Every line is optional.

# --- Web server -------------------------------------------------------------
HOST=0.0.0.0
PORT=5000

# --- GPS --------------------------------------------------------------------
# auto      = use the real GPS module if its port opens, otherwise use the simulator
# serial    = real module only (never simulate)
# simulator = fake data (good for testing on a PC)
GPS_MODE=serial
# Leave blank to auto-detect. Raspberry Pi GPIO wiring: /dev/serial0
# USB GPS on Linux: /dev/ttyACM0 or /dev/ttyUSB0      Windows: COM3 (check Device Manager)
GPS_PORT=/dev/ttyAMA0
GPS_BAUD=9600

# --- Google Maps (optional) -------------------------------------------------
# Paste your Maps JavaScript API key to use Google Maps.
# With no key (or an invalid one) the dashboard uses OpenStreetMap automatically.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAP_ID=DEMO_MAP_ID

# --- Raspberry Pi hardware (BCM numbering) ----------------------------------
HARDWARE=auto
BUZZER_PIN=18
LED_GREEN_PIN=23
LED_RED_PIN=24
OLED=auto
# Display: NFP1315-157B Y, 0.96" 128x64 I2C OLED (SSD1306-compatible)
OLED_DRIVER=ssd1306
OLED_I2C_PORT=1
# i2cdetect -y 1 should show 3c for this panel; some boards ship at 3d
OLED_I2C_ADDRESS=0x3C

# --- Voice ------------------------------------------------------------------
VOICE_ENABLED=true

# --- Simulator start point and speed (metres per second) --------------------
SIM_LAT=14.5995
SIM_LON=120.9842
SIM_SPEED=3.0
